# Copy this file to .env and fill in every value. The server refuses to start if any of the
# required variables below is missing or empty. Never commit the real .env file.

# Secret used to sign login tokens. Use a long random string, for example the output of
# `python -c "import secrets; print(secrets.token_urlsafe(64))"`. Changing it logs everyone out.
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY

# URL of your Supabase project (Supabase dashboard > Project Settings > API > Project URL).
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# Supabase service_role key (Supabase dashboard > Project Settings > API keys). The backend uses it
# to reach the database with full rights, so keep it on the server only and never in front-end code.
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Mapbox access token the server uses for route and travel-time requests (Directions API).
# Create one at https://account.mapbox.com/access-tokens/
MAPBOX_API_KEY=YOUR_MAPBOX_SERVER_TOKEN

# Resend API key for sending invitation and notification e-mails. Create one at
# https://resend.com/api-keys and verify your sending domain at https://resend.com/domains
RESEND_API_KEY=YOUR_RESEND_API_KEY

# Redis connection URL, used for caching, token revocation and rate limiting.
# Format: redis://default:PASSWORD@HOST:PORT (use rediss:// for a TLS connection).
REDIS_URL=YOUR_REDIS_URL

# Public address of the application, used in links sent by e-mail and for CORS.
# Locally use http://localhost:8000; an https:// address switches the app to production mode.
BASE_URL=http://localhost:8000

# Optional. Sentry DSN for error tracking (sentry.io > Settings > Projects > your project >
# Client Keys (DSN)). If it is left unset, error tracking is off and the app runs normally.
# SENTRY_DSN=YOUR_SENTRY_DSN
